{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "bretts-mod-flair",
  "title": "Brett's Mod Flair",
  "description": "Flair management tool — assign, batch update, auto-flair by keyword",
  "requiredPermissions": ["read", "submit", "modposts"],
  "triggers": {
